# The OpenRouter key the asset scripts read. Never commit it.
.env

# Match the root .gitignore: build output is generated, but the bundle is kept.
build/*
!build/*.pbw

# Generation inputs and intermediates — raw renders, superseded character
# versions, the walk-cycle GIFs the sprite scripts read and the B/W previews
# they write. resources/images itself now holds only what package.json declares
# plus the two bank previews, so the directory IS the keep-list: a new file
# there shows up in git status instead of silently vanishing into a wildcard.
resources/images/drafts/

# Third-party reference photos and the multi-megabyte veo render.
resources/inspo/
resources/video/
