# The OpenRouter key the asset scripts read. Never commit it.
.env

# Match the root .gitignore: build output is generated, but the bundle is kept.
build/*
!build/*.pbw

# Generation intermediates — raw renders, superseded character versions and
# the B/W preview GIFs to_bw.sh writes. The colour walk-cycle GIFs are NOT
# drafts: to_bw.sh and preview_watchface.sh read them, and the nix preBuild
# only sees tracked files, so they stay beside the assets package.json
# declares. resources/images itself is the keep-list: a new file there shows
# up in git status instead of silently vanishing into a wildcard.
resources/images/drafts/

# Third-party reference photos and the multi-megabyte veo render.
resources/inspo/
resources/video/
